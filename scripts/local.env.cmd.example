rem Copy this file to scripts\local.env.cmd and edit it. local.env.cmd is not committed.
rem Python 3.13 used to create backend\.venv (this machine: Miniconda base)
set "WENSHU_PYTHON=C:\Python313\python.exe"
rem Uncomment to share data with the packaged exe, or to keep data somewhere else
rem set "WENSHU_DATA_DIR=D:\Apps\WenShu\data"
rem Optional: JSON file that describes the default custom model (name, base_url, api_key, model, ...).
rem It is imported on start when no model with that name exists yet. Default: backend\models.local.json
rem (see backend\models.local.json.example). It holds a plain API key: keep it out of git and out of data.
rem set "WENSHU_MODELS_FILE=D:\secrets\wenshu-models.json"
